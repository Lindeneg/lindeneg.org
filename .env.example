# email,firstname,lastname,password; only used to create the admin once, when none exists
SUPER_USER=email,firstname,lastname,password

PORT=3000

# development | production | test
NODE_ENV=development

# comma separated origins allowed to call /api/cl-software
ORIGINS=https://freelance.lindeneg.org

DATABASE_URL=file:./data/local.db

PUBLIC_STATIC_ROOT=./public

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE_MS=604800000 # 7 days

# optional
# BCRYPT_ROUNDS=12
# LOG_LEVEL=info
# express "trust proxy"; defaults to loopback (a reverse proxy like nginx on the same host), e.g. 1 for a single hop, 0 disables it
# TRUST_PROXY=loopback
