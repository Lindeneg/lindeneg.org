{
    "name": "lindeneg.org",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "fix-timestamps": "npx -y tsx scripts/fix-timestamps.ts",
        "seed": "npx -y tsx scripts/seed.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "test:unit": "vitest run --project unit",
        "test:e2e": "bash scripts/test-e2e.sh",
        "fix-tags": "npx -y tsx scripts/fix-tags.ts",
        "bootstrap": "bash scripts/bootstrap.sh",
        "clean": "bash scripts/clean.sh"
    },
    "dependencies": {
        "@lindeneg/cl-env": "0.1.3",
        "@prisma/adapter-better-sqlite3": "7.10.0",
        "@prisma/client": "7.10.0",
        "bcrypt": "6.0.0",
        "cloudinary": "2.11.0",
        "compression": "1.8.2",
        "cookie-parser": "1.4.7",
        "cors": "2.8.6",
        "express": "5.2.1",
        "highlight.js": "11.12.0",
        "jsonwebtoken": "9.0.3",
        "marked": "18.0.14",
        "multer": "2.4.0",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "pino-pretty": "13.1.3",
        "sanitize-html": "2.17.7",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/cookie-parser": "1.4.10",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "2.2.0",
        "@types/node": "24.13.6",
        "@types/sanitize-html": "2.16.1",
        "prisma": "7.10.0",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.1"
    },
    "allowScripts": {
        "better-sqlite3@12.10.0": true,
        "bcrypt@6.0.0": true,
        "prisma@7.10.0": true,
        "@prisma/engines@7.10.0": true,
        "esbuild@0.28.2": true
    }
}
